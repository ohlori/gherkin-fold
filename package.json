{
  "name": "gherkin-fold",
  "displayName": "Gherkin Fold",
  "icon": "images/logo.png",
  "description": "View all scenarios in a glance.",
  "version": "1.0.3",
  "publisher": "ohlori",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ohlori/gherkin-fold.git"
  },
  "homepage": "https://github.com/ohlori/gherkin-fold#readme",
  "bugs": {
    "url": "https://github.com/ohlori/gherkin-fold/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "cucumber",
    "cucumber folding",
    "feature",
    "feature file",
    "folding",
    "gherkin",
    "gherkin fold",
    "gherkin folding",
    "scenario",
    "scenario fold",
    "scenario folding",
    "collapse scenarios"
  ],
  "activationEvents": [
    "onLanguage:feature"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "configurationDefaults": {
      "cursor.general.pinnedTitleActions": [
        "gherkinFold.foldScenarios",
        "gherkinFold.expandScenarios"
      ]
    },
    "commands": [
      {
        "command": "gherkinFold.foldScenarios",
        "title": "Collapse All Scenarios",
        "category": "Gherkin Fold",
        "icon": "$(collapse-all)",
        "enablement": "resourceExtname == .feature"
      },
      {
        "command": "gherkinFold.expandScenarios",
        "title": "Expand All Scenarios",
        "category": "Gherkin Fold",
        "icon": "$(expand-all)",
        "enablement": "resourceExtname == .feature"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gherkinFold.foldScenarios",
          "when": "resourceExtname == .feature",
          "group": "navigation@1"
        },
        {
          "command": "gherkinFold.expandScenarios",
          "when": "resourceExtname == .feature",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Gherkin Fold",
      "properties": {
        "gherkinFold.collapseOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Collapse scenarios once when a .feature document first becomes active."
        }
      }
    },
    "languages": [
      {
        "id": "feature",
        "aliases": [
          "Gherkin",
          "Cucumber",
          "feature"
        ],
        "extensions": [
          ".feature"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "pretest": "npm run compile",
    "test": "node --test dist/test/*.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  }
}
